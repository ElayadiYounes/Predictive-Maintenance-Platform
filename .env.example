#######################################
# ENVIRONMENT
#######################################

APP_ENV=dev
DEBUG=true

PROJECT_NAME=ocp-predictive-maintenance-platform
PROJECT_VERSION=1.0.0

TZ=Africa/Casablanca

LOG_LEVEL=INFO

#######################################
# MYSQL (OCP SOURCE DATABASE)
#######################################

MYSQL_HOST=host.docker.internal#permet à un conteneur Docker d'accéder aux services exécutés sur la machine hôte
MYSQL_PORT=3306

MYSQL_DATABASE=moteur

MYSQL_USER=root
MYSQL_PASSWORD=

MYSQL_CHARSET=utf8mb4

#######################################
# POSTGRES (HIVE METASTORE)
#######################################

POSTGRES_HOST=postgres

POSTGRES_PORT=5432

POSTGRES_HIVE_DATABASE=hive_metastore
POSTGRES_AIRFLOW_DATABASE=airflow

POSTGRES_USER=

POSTGRES_PASSWORD=

#######################################
# MINIO (DATA LAKE)
#######################################

MINIO_ENDPOINT=http://minio:9000

MINIO_API_PORT=9000

MINIO_CONSOLE_PORT=9001

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

MINIO_REGION=us-east-1

BRONZE_BUCKET=bronze
SILVER_BUCKET=silver
GOLD_BUCKET=gold
MODELS_BUCKET=models


#######################################
# SPARK
#######################################
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080



#######################################
# HIVE METASTORE
#######################################

HIVE_METASTORE_HOST=hive-metastore
HIVE_METASTORE_PORT=9083

HIVE_WAREHOUSE_DIR=s3a://gold/

HIVE_METASTORE_DB_TYPE=postgres


#######################################
# AIRFLOW
#######################################

AIRFLOW_PORT=8082

AIRFLOW_SECRET_KEY=

AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=

AIRFLOW_ADMIN_FIRSTNAME=
AIRFLOW_ADMIN_LASTNAME=
#######################################
#API
#######################################
API_HOST=api

API_PORT=8000
#######################################
#ML
#######################################
MODEL_PATH=models

RANDOM_STATE=42

ANOMALY_THRESHOLD=0.8

MODEL_RETRAIN_INTERVAL_DAYS=30
#######################################
#EMAIL ALERT
#######################################
SMTP_HOST=smtp.gmail.com

SMTP_PORT=587

SMTP_USERNAME=

SMTP_PASSWORD=

SMTP_FROM=

SMTP_TLS=True